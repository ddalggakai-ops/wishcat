rules_version = '2';

// 위시캣 Firestore 보안 규칙
// - Cloud Functions(유료 Blaze 요금제)를 쓰지 않고 클라이언트가 직접 문서를 쓰는 구조라,
//   "친구의 아이템에 나를 추가하는" 것처럼 소유자가 아닌 사용자가 일부 필드만 건드릴 수 있도록
//   필드 단위로 제한된 update 규칙을 사용합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid} ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'bio', 'listPublic', 'photoUrl']);
      // 계정 삭제(구글 플레이 정책상 앱 안에서 가능해야 함) — 본인만
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── items/{itemId} ───────────────────────────────────────────
    match /items/{itemId} {
      // ownerPublic은 users.listPublic을 아이템에 비정규화한 값입니다.
      // 둘러보기 쿼리(where ownerPublic == true)를 규칙 안에서 get() 없이 통과시키기 위한 빠른 경로이고,
      // 값이 없거나 false인 문서는 종전대로 users 문서를 직접 읽어 판정합니다.
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || resource.data.get('ownerPublic', false) == true
        || get(/databases/$(database)/documents/users/$(resource.data.ownerId)).data.listPublic != false
        || exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + resource.data.ownerId))
      );

      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      allow update: if request.auth != null && (
        // 소유자는 자유롭게 수정 (edit / complete / reopen / 공개여부 백필 등)
        request.auth.uid == resource.data.ownerId

        // "함께하기(join)" — participants에 본인을 추가, savesCount 증가
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'savesCount'])
          && request.resource.data.participants.hasAll(resource.data.participants)
          && request.resource.data.participants.size() <= resource.data.participants.size() + 1
        )

        // "함께하기 취소(leave)" — 본인만 participants에서 제거, savesCount는 0 또는 −1만
        // (예전엔 '부분집합'만 검사해서, 남의 참여자를 통째로 빼거나 savesCount를 임의 값으로
        //  바꿀 수 있었습니다. 본인 1명만 빠지고 카운트는 최대 1만 줄도록 좁힙니다.)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'savesCount'])
          && resource.data.participants.hasAll(request.resource.data.participants)
          && resource.data.participants.hasAny([request.auth.uid])
          && !request.resource.data.participants.hasAny([request.auth.uid])
          && request.resource.data.participants.size() == resource.data.participants.size() - 1
          && request.resource.data.savesCount >= resource.data.savesCount - 1
          && request.resource.data.savesCount <= resource.data.savesCount
        )

        // "도와서 이뤄줌(help)" — done 처리 + helpedBy/participants에 본인 추가
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'helpedBy', 'participants'])
          && request.resource.data.done == true
          && request.resource.data.helpedBy.hasAll(resource.data.helpedBy)
        )

        // 좋아요 토글 — likesCount ±1만 변경
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
          && (
            request.resource.data.likesCount == resource.data.likesCount + 1
            || request.resource.data.likesCount == resource.data.likesCount - 1
          )
        )
      );

      // items/{itemId}/likes/{uid} — 좋아요 여부를 문서 존재로 표현 (문서 id == 누른 사람의 uid)
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ── friendships/{ownerUid_friendUid} ────────────────────────
    match /friendships/{friendshipId} {
      // 친구가 아직 아닌 사이엔 friendships/{나_상대} 문서가 아예 없을 수 있어요(정상).
      // 존재하지 않는 문서를 get()으로 읽을 때 resource가 null이 되는데, 그 상태에서
      // resource.data를 바로 참조하면 규칙 평가 자체가 오류로 취급돼 거부(permission-denied)돼요.
      // resource == null인 경우를 먼저 허용해서 "없다"는 답을 정상적으로 받을 수 있게 합니다
      // (문서가 없으니 어차피 새어나갈 데이터도 없어요).
      allow read: if request.auth != null && (
        resource == null
        || resource.data.owner == request.auth.uid || resource.data.friend == request.auth.uid
      );
      // 친구 관계는 '상대의 초대 코드'를 통한 상호 동의로만 생깁니다.
      // 예전엔 owner/friend 중 하나가 본인이기만 하면 문서를 만들 수 있어서, 상대 uid만 알면
      // friendships/{나}_{상대} 를 스스로 만들어 상대의 비공개 목록·사진을 열람할 수 있었습니다(치명).
      // 이제 문서에 via(초대 코드)를 담게 하고, 그 초대의 발신자가 '상대(=내가 아닌 쪽)'인지 확인합니다.
      // 초대 코드는 상대만 만들 수 있고(초대 create 규칙: fromUserId == 본인), 상대가 링크를 공유해야만
      // 얻을 수 있으므로, 코드 소지 = 상대의 공유 동의로 봅니다(앱의 초대 링크 모델 그대로).
      allow create: if request.auth != null
        && friendshipId == request.resource.data.owner + '_' + request.resource.data.friend
        && (request.resource.data.owner == request.auth.uid || request.resource.data.friend == request.auth.uid)
        && (
          // (1) 초대 코드 경로 — 이 초대의 발신자가 '상대(내가 아닌 쪽)'여야 함
          (
            request.resource.data.via is string
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.via))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.via)).data.fromUserId ==
                 (request.resource.data.owner == request.auth.uid
                   ? request.resource.data.friend
                   : request.resource.data.owner)
          )
          // (2) 친구 신청 수락 경로 — '상대가 나에게 보낸 신청'이 있어야 함(수락하는 사람만 생성 가능)
          || exists(/databases/$(database)/documents/friendRequests/$(
               (request.resource.data.owner == request.auth.uid
                 ? request.resource.data.friend
                 : request.resource.data.owner) + '_' + request.auth.uid
             ))
        );
      allow update: if false;
      // 계정 삭제/친구 끊기 시 양방향 문서를 정리할 수 있어야 합니다.
      allow delete: if request.auth != null && (
        resource.data.owner == request.auth.uid || resource.data.friend == request.auth.uid
      );
    }

    // ── friendRequests/{fromUid_toUid} ───────────────────────────
    // 초대 링크 없이 사용자끼리 직접 친구를 맺기 위한 '친구 신청'.
    // 보내는 사람만 자기 신청을 만들 수 있고, 당사자(보낸/받은 사람)만 읽고 지웁니다.
    // 받는 사람이 수락하면 friendships 두 개를 만들고(위 create 경로 2) 이 문서를 지웁니다.
    match /friendRequests/{reqId} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && reqId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.from == request.auth.uid
        && request.resource.data.from != request.resource.data.to;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ── invites/{code} ───────────────────────────────────────────
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.fromUserId == request.auth.uid;
      allow update: if false;
      // 계정 삭제 시 본인이 만든 초대를 정리
      allow delete: if request.auth != null && resource.data.fromUserId == request.auth.uid;
    }

    // ── reports/{autoId} ─────────────────────────────────────────
    // 신고 접수함. 누구도 읽을 수 없고(운영자는 콘솔에서 확인), 로그인 사용자가 만들기만 가능.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow update, delete: if false;
    }

    // ── blocks/{blockerUid}/blocked/{targetUid} ──────────────────
    // 차단 목록은 본인만 읽고 씁니다.
    match /blocks/{blockerUid}/blocked/{targetUid} {
      allow read, create, delete: if request.auth != null && request.auth.uid == blockerUid;
      allow update: if false;
    }

    // ── admins/{uid} ─────────────────────────────────────────────
    // 관리자 표식. 콘솔에서만 만들고(앱/클라이언트는 쓰기 불가), 존재 여부로 운영 권한을 판정합니다.
    // 관리자로 지정하려면 Firebase 콘솔에서 admins/{내 uid} 문서를 하나 만들어 두세요.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── starterPacks/{key} ───────────────────────────────────────
    // 관리자가 앱 재빌드 없이 운영하는 '추천 버킷 모음'. 누구나(로그인) 읽고, 관리자만 씁니다.
    match /starterPacks/{key} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
